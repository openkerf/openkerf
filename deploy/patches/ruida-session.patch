+"""Session regressions: all transport I/O is fake; no kernel or sockets."""
+import queue
+import threading
+import time
+import unittest
+from concurrent.futures import Future
+from types import SimpleNamespace
+from unittest.mock import patch, Mock
+
+from meerk40t.ruida.rdjob import ACK, NAK, ENQ, GET_SETTING, MEM_MACHINE_STATUS, MEM_CURRENT_X
+from meerk40t.ruida.ruidasession import RuidaSession
+from meerk40t.ruida.ruidatransport import TransportError, TransportTimeout
+
+
+def wait_for(predicate, timeout=2):
+    deadline = time.monotonic() + timeout
+    while time.monotonic() < deadline:
+        if predicate():
+            return
+        time.sleep(0.005)
+    raise AssertionError("Timed out waiting for session state")
+
+
+class FakeTransport:
+    def __init__(self, service):
+        self.is_open = False
+        self.connected = False
+        self.writes = []
+        self.owners = set()
+        self.incoming = queue.Queue()
+        self.fail_opens = 0
+        self.opens = 0
+        self.respond = lambda data: [ACK]
+        self.on_write = None
+
+    def touch(self):
+        self.owners.add(threading.get_ident())
+
+    def open(self):
+        self.touch()
+        self.opens += 1
+        if self.fail_opens:
+            self.fail_opens -= 1
+            raise TransportError("bind failed")
+        self.is_open = self.connected = True
+
+    def close(self):
+        self.touch()
+        self.is_open = self.connected = False
+        while not self.incoming.empty():
+            self.incoming.get_nowait()
+
+    def set_timeout(self, timeout):
+        self.touch()
+
+    def write(self, data):
+        self.touch()
+        if not self.is_open:
+            raise TransportError("closed")
+        self.writes.append(data)
+        if self.on_write:
+            self.on_write(data)
+        for reply in self.respond(data):
+            self.incoming.put(reply)
+
+    def read(self, size):
+        self.touch()
+        try:
+            return self.incoming.get(timeout=0.02)
+        except queue.Empty:
+            raise TransportTimeout()
+
+    def purge(self):
+        self.touch()
+        while not self.incoming.empty():
+            self.incoming.get_nowait()
+
