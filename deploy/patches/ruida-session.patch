+            return self.received.append if name.endswith("/recv") else lambda *a: None
+        self.service = SimpleNamespace(interface="udp", safe_label="test", channel=channel,
+                                       signal=lambda *a: None)
+        self.transport = FakeTransport(self.service)
+        self.patch = patch("meerk40t.ruida.ruidasession.udp.UDPTransport", return_value=self.transport)
+        self.patch.start()
+        self.session = RuidaSession(self.service)
+        self.session.set_swizzles(bytes, bytes)
+        self.session._tries = 2
+        self.session.open()
